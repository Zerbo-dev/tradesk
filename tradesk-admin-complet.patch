diff --git a/src/app/admin/admin.css b/src/app/admin/admin.css
index bb418e6..1f0a4d9 100644
--- a/src/app/admin/admin.css
+++ b/src/app/admin/admin.css
@@ -233,3 +233,58 @@ textarea.input { resize: vertical; min-height: 160px; font-size: 12.5px; line-he
   padding: 28px;
   box-shadow: var(--shadow);
 }
+
+/* ---- Layout dashboard (sidebar + contenu) ---- */
+.dash-shell { display: flex; min-height: 100vh; }
+.dash-sidebar {
+  width: 216px;
+  flex-shrink: 0;
+  background: var(--bg-elevated);
+  border-right: 1px solid var(--line);
+  padding: 22px 14px;
+  position: sticky;
+  top: 0;
+  height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+.dash-nav { margin-top: 26px; display: flex; flex-direction: column; gap: 2px; }
+.dash-nav a {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 9px 12px;
+  border-radius: 9px;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--text-soft);
+  text-decoration: none;
+  transition: background .12s, color .12s;
+}
+.dash-nav a:hover { background: var(--panel-soft); color: var(--text); }
+.dash-nav a.active { background: var(--green-soft); color: var(--green-bright); }
+.dash-content { flex: 1; min-width: 0; }
+.dash-inner { max-width: 900px; margin: 0 auto; padding: 32px 28px 90px; }
+
+.kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
+  gap: 12px;
+  margin-bottom: 20px;
+}
+.kpi-card {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 16px;
+}
+.kpi-label { font-size: 11px; color: var(--text-faint); text-transform: uppercase; letter-spacing: .04em; font-weight: 700; }
+.kpi-value { font-family: var(--display); font-size: 24px; font-weight: 800; margin-top: 6px; }
+
+.sparkline { display: block; width: 100%; height: 60px; margin-top: 10px; }
+
+@media (max-width: 760px) {
+  .dash-shell { flex-direction: column; }
+  .dash-sidebar { width: 100%; height: auto; position: static; }
+  .dash-nav { flex-direction: row; overflow-x: auto; margin-top: 14px; }
+}
